{
  "name": "folio",
  "productName": "Folio",
  "version": "1.0.0",
  "description": "Lettore ed editor Markdown per macOS, con albero delle cartelle e tab multiple",
  "author": "cesarebed",
  "license": "MIT",
  "homepage": "https://github.com/cesarebed/folio",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesarebed/folio.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "reader",
    "macos",
    "electron"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --mac --dir && node scripts/sign.mjs",
    "dist:dmg": "electron-vite build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.cesare.folio",
    "productName": "Folio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "darkModeSupport": true,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Folio legge e salva i file Markdown sulla Scrivania.",
        "NSDocumentsFolderUsageDescription": "Folio legge e salva i file Markdown nei Documenti.",
        "NSDownloadsFolderUsageDescription": "Folio legge e salva i file Markdown nei Download."
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn"
        ],
        "name": "Markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "textbundle"
        ],
        "name": "Text Bundle",
        "role": "Editor",
        "rank": "Alternate",
        "isPackage": true
      }
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "type": "commonjs"
}
